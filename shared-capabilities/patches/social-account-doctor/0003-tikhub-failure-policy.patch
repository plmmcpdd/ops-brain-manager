+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+
+
+CLIENT_PATH = Path(__file__).resolve().parents[1] / "tikhub" / "lib" / "tikhub_client.py"
+
+
+def load_client_module():
+    spec = importlib.util.spec_from_file_location("tikhub_client_under_test", CLIENT_PATH)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def client(module):
+    return module.TikhubClient("xiaohongshu", api_key="test-key", timeout=1)
+
+
+def test_transient_failure_retries_same_request_once(monkeypatch):
+    module = load_client_module()
+    instance = client(module)
+    monkeypatch.setattr(instance, "_ensure_session", lambda: "session-a")
+    monkeypatch.setattr(module.time, "sleep", lambda _seconds: None)
+    calls = []
+
+    def fake_post(payload, session_id):
+        calls.append((payload["params"], session_id))
+        if len(calls) == 1:
+            return {
+                "result": {
+                    "isError": True,
+                    "content": [{"type": "text", "text": "can't start new thread"}],
+                }
+            }, {}
+        return {"result": {"ok": True}}, {}
+
+    monkeypatch.setattr(instance, "_post", fake_post)
+    params = {"name": "search", "arguments": {"keyword": "移民"}}
+    assert instance._call_jsonrpc("tools/call", params) == {"ok": True}
+    assert calls == [(params, "session-a"), (params, "session-a")]
+
+
+def test_session_failure_gets_original_retry_then_one_refresh(monkeypatch):
+    module = load_client_module()
+    instance = client(module)
+    sessions = iter(("session-a", "session-a", "session-b"))
+    monkeypatch.setattr(instance, "_ensure_session", lambda: next(sessions))
+    monkeypatch.setattr(module.time, "sleep", lambda _seconds: None)
+    dropped = []
+    monkeypatch.setattr(instance, "_drop_session", lambda: dropped.append(True))
+    calls = []
+
+    def fake_post(payload, session_id):
+        calls.append(session_id)
+        if len(calls) < 3:
+            raise module.TikhubError("MCP session expired", status_code=440)
+        return {"result": "ready"}, {}
+
+    monkeypatch.setattr(instance, "_post", fake_post)
+    assert instance._call_jsonrpc("tools/call", {"same": "params"}) == "ready"
+    assert calls == ["session-a", "session-a", "session-b"]
+    assert dropped == [True]
+
+
+def test_401_is_not_retried_and_does_not_refresh(monkeypatch):
+    module = load_client_module()
+    instance = client(module)
+    monkeypatch.setattr(instance, "_ensure_session", lambda: "session-a")
+    dropped = []
+    monkeypatch.setattr(instance, "_drop_session", lambda: dropped.append(True))
+    calls = []
+
+    def fake_post(payload, session_id):
+        calls.append(session_id)
+        raise module.TikhubCredentialError("HTTP 401", status_code=401)
+
+    monkeypatch.setattr(instance, "_post", fake_post)
+    with pytest.raises(module.TikhubCredentialError, match="not retried"):
+        instance._call_jsonrpc("tools/call", {})
+    assert calls == ["session-a"]
+    assert dropped == []
+
+
+def test_429_backs_off_without_more_than_one_retry(monkeypatch):
+    module = load_client_module()
+    instance = client(module)
+    monkeypatch.setattr(instance, "_ensure_session", lambda: "session-a")
+    sleeps = []
+    monkeypatch.setattr(module.time, "sleep", sleeps.append)
+    calls = []
+
+    def fake_post(payload, session_id):
+        calls.append(session_id)
+        raise module.TikhubError("HTTP 429: rate limited", status_code=429)
+
+    monkeypatch.setattr(instance, "_post", fake_post)
+    with pytest.raises(module.TikhubUnavailableError, match="layer unavailable"):
+        instance._call_jsonrpc("tools/call", {})
+    assert calls == ["session-a", "session-a"]
+    assert sleeps == [1.0]
+
+
+def test_exhausted_transient_failure_is_marked_unavailable(monkeypatch):
+    module = load_client_module()
+    instance = client(module)
+    monkeypatch.setattr(instance, "_ensure_session", lambda: "session-a")
+    monkeypatch.setattr(module.time, "sleep", lambda _seconds: None)
+
+    def fail(payload, session_id):
+        raise module.TikhubError("upstream down")
+
+    monkeypatch.setattr(instance, "_post", fail)
+    with pytest.raises(module.TikhubUnavailableError, match="TikHub layer unavailable"):
+        instance._call_jsonrpc("tools/call", {})
