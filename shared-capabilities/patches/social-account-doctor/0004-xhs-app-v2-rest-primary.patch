@@ -0,0 +1,311 @@
+"""Direct TikHub Xiaohongshu App V2 REST transport.
+
+This module intentionally covers only the App V2 actions used by Social Doctor.
+Other platforms continue to use the MCP transport in ``tikhub_client.py``.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import socket
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+from typing import Any, Callable
+
+from tikhub_client import load_api_key
+
+
+DEFAULT_BASE_URL = "https://api.tikhub.io"
+DEFAULT_TIMEOUT_SECONDS = 45
+
+ACTION_SCHEMAS = {
+    "search_notes": {
+        "required": {"keyword"},
+        "integer": {"page", "ai_mode"},
+        "defaults": {
+            "page": 1,
+            "sort_type": "general",
+            "note_type": "不限",
+            "time_filter": "不限",
+            "search_id": "",
+            "search_session_id": "",
+            "source": "explore_feed",
+            "ai_mode": 0,
+        },
+        "allowed": {
+            "keyword", "page", "sort_type", "note_type", "time_filter",
+            "search_id", "search_session_id", "source", "ai_mode",
+        },
+        "collection_keys": ("items",),
+    },
+    "search_users": {
+        "required": {"keyword"},
+        "integer": {"page"},
+        "defaults": {"page": 1, "search_id": "", "source": "explore_feed"},
+        "allowed": {"keyword", "page", "search_id", "source"},
+        "collection_keys": ("items", "users"),
+    },
+    "get_user_posted_notes": {
+        "required_any": ({"user_id", "share_text"},),
+        "defaults": {"user_id": "", "share_text": "", "cursor": ""},
+        "allowed": {"user_id", "share_text", "cursor"},
+        "collection_keys": ("items", "notes"),
+    },
+    "get_image_note_detail": {
+        "required_any": ({"note_id", "share_text"},),
+        "defaults": {"note_id": "", "share_text": ""},
+        "allowed": {"note_id", "share_text"},
+    },
+    "get_video_note_detail": {
+        "required_any": ({"note_id", "share_text"},),
+        "defaults": {"note_id": "", "share_text": ""},
+        "allowed": {"note_id", "share_text"},
+    },
+    "get_note_comments": {
+        "required_any": ({"note_id", "share_text"},),
+        "integer": {"index"},
+        "defaults": {
+            "note_id": "", "share_text": "", "cursor": "", "index": 0,
+            "pageArea": "UNFOLDED", "sort_strategy": "latest_v2",
+        },
+        "allowed": {
+            "note_id", "share_text", "cursor", "index", "pageArea", "sort_strategy",
+        },
+        "collection_keys": ("items", "comments"),
+    },
+    "get_note_sub_comments": {
+        "required": {"comment_id"},
+        "required_any": ({"note_id", "share_text"},),
+        "integer": {"index"},
+        "defaults": {
+            "note_id": "", "share_text": "", "cursor": "", "index": 1,
+        },
+        "allowed": {"note_id", "share_text", "comment_id", "cursor", "index"},
+        "collection_keys": ("items", "comments"),
+    },
+    "get_user_info": {
+        "required_any": ({"user_id", "share_text"},),
+        "defaults": {"user_id": "", "share_text": ""},
+        "allowed": {"user_id", "share_text"},
+    },
+}
+
+PROVIDER_TOOL_PREFIX = "xiaohongshu_app_v2_"
+LIST_ACTIONS = {
+    action for action, schema in ACTION_SCHEMAS.items() if schema.get("collection_keys")
+}
+
+
+class XhsRestError(Exception):
+    def __init__(
+        self,
+        message: str,
+        *,
+        category: str,
+        http_status: int | None = None,
+        retry_count: int = 0,
+    ):
+        super().__init__(message)
+        self.category = category
+        self.http_status = http_status
+        self.retry_count = retry_count
+
+    def payload(self) -> dict[str, Any]:
+        return {
+            "error": str(self),
+            "layer": "TikHub",
+            "platform": "xiaohongshu",
+            "transport": "rest",
+            "status": "unavailable",
+            "category": self.category,
+            "http_status": self.http_status,
+            "retry_count": self.retry_count,
+        }
+
+
+def canonical_action(tool_name: str) -> str:
+    action = tool_name
+    if action.startswith(PROVIDER_TOOL_PREFIX):
+        action = action[len(PROVIDER_TOOL_PREFIX):]
+    if action not in ACTION_SCHEMAS:
+        raise XhsRestError(
+            f"unsupported Xiaohongshu App V2 action: {tool_name}",
+            category="request_error",
+        )
+    return action
+
+
+def validate_arguments(action: str, arguments: dict[str, Any]) -> dict[str, Any]:
+    schema = ACTION_SCHEMAS[action]
+    unknown = sorted(set(arguments) - schema["allowed"])
+    if unknown:
+        raise XhsRestError(
+            f"unsupported parameter(s) for {action}: {', '.join(unknown)}",
+            category="request_error",
+        )
+    params = {**schema.get("defaults", {}), **arguments}
+    for name in schema.get("integer", set()):
+        value = params.get(name)
+        if isinstance(value, bool):
+            raise XhsRestError(f"{name} must be an integer", category="request_error")
+        try:
+            params[name] = int(value)
+        except (TypeError, ValueError) as error:
+            raise XhsRestError(f"{name} must be an integer", category="request_error") from error
+    missing = [name for name in schema.get("required", set()) if not params.get(name)]
+    if missing:
+        raise XhsRestError(
+            f"missing required parameter(s) for {action}: {', '.join(sorted(missing))}",
+            category="request_error",
+        )
+    for alternatives in schema.get("required_any", ()):
+        if not any(params.get(name) for name in alternatives):
+            raise XhsRestError(
+                f"{action} requires one of: {', '.join(sorted(alternatives))}",
+                category="request_error",
+            )
+    return params
+
+
+def _provider_data(payload: dict[str, Any]) -> Any:
+    value = payload.get("data")
+    if isinstance(value, dict) and "data" in value:
+        return value["data"]
+    return value
+
+
+def _collection(data: Any, keys: tuple[str, ...]) -> list[Any]:
+    if isinstance(data, list):
+        return data
+    if isinstance(data, dict):
+        for key in keys:
+            value = data.get(key)
+            if isinstance(value, list):
+                return value
+    return []
+
+
+def _metadata(data: Any) -> dict[str, Any]:
+    if not isinstance(data, dict):
+        return {}
+    names = {
+        "cursor", "has_more", "hasMore", "search_id", "searchId",
+        "search_session_id", "searchSessionId", "page", "total",
+    }
+    return {name: data[name] for name in names if name in data}
+
+
+def normalize_response(action: str, payload: dict[str, Any], http_status: int) -> dict[str, Any]:
+    provider_code = payload.get("code")
+    if provider_code not in (None, 0, 200, "0", "200"):
+        raise XhsRestError(
+            f"TikHub provider returned code {provider_code}: "
+            f"{payload.get('message') or payload.get('message_zh') or 'provider error'}",
+            category="provider_error",
+            http_status=http_status,
+        )
+    data = _provider_data(payload)
+    normalized = {
+        "ok": True,
+        "layer": "TikHub",
+        "platform": "xiaohongshu",
+        "transport": "rest",
+        "action": action,
+        "provider": {
+            "http_status": http_status,
+            "code": provider_code,
+            "request_id": payload.get("request_id"),
+            "message": payload.get("message"),
+        },
+        "pagination": _metadata(data),
+    }
+    if action in LIST_ACTIONS:
+        normalized["items"] = _collection(data, ACTION_SCHEMAS[action]["collection_keys"])
+        normalized["data"] = {
+            key: value
+            for key, value in data.items()
+            if isinstance(data, dict)
+            and key not in ACTION_SCHEMAS[action]["collection_keys"]
+        } if isinstance(data, dict) else {}
+    else:
+        normalized["data"] = data
+    return normalized
+
+
+class XhsRestClient:
+    def __init__(
+        self,
+        api_key: str | None = None,
+        base_url: str | None = None,
+        timeout: int | None = None,
+        *,
+        urlopen: Callable[..., Any] = urllib.request.urlopen,
+        sleep: Callable[[float], None] = time.sleep,
+    ):
+        self.api_key = api_key or load_api_key()
+        self.base_url = (base_url or os.environ.get("TIKHUB_REST_BASE_URL") or DEFAULT_BASE_URL).rstrip("/")
+        self.timeout = timeout or int(os.environ.get("TIKHUB_REST_TIMEOUT_SECONDS", DEFAULT_TIMEOUT_SECONDS))
+        self._urlopen = urlopen
+        self._sleep = sleep
+
+    def call(self, tool_name: str, arguments: dict[str, Any] | None = None) -> dict[str, Any]:
+        action = canonical_action(tool_name)
+        params = validate_arguments(action, arguments or {})
+        query = urllib.parse.urlencode(params)
+        url = f"{self.base_url}/api/v1/xiaohongshu/app_v2/{action}?{query}"
+        request = urllib.request.Request(
+            url,
+            headers={
+                "Authorization": f"Bearer {self.api_key}",
+                "Accept": "application/json",
+                "User-Agent": "social-account-doctor-xhs-rest/0.1",
+            },
+            method="GET",
+        )
+        last_error: XhsRestError | None = None
+        for attempt in range(2):
+            try:
+                with self._urlopen(request, timeout=self.timeout) as response:
+                    http_status = response.status
+                    payload = json.loads(response.read().decode("utf-8"))
+                return normalize_response(action, payload, http_status)
+            except urllib.error.HTTPError as error:
+                if error.code == 401:
+                    raise XhsRestError(
+                        "TikHub credential problem (HTTP 401); request was not retried",
+                        category="credential_problem",
+                        http_status=401,
+                    ) from error
+                category = "rate_limited" if error.code == 429 else (
+                    "transient" if error.code >= 500 else "request_error"
+                )
+                last_error = XhsRestError(
+                    f"TikHub REST HTTP {error.code}",
+                    category=category,
+                    http_status=error.code,
+                    retry_count=attempt,
+                )
+                if attempt == 0 and category in {"rate_limited", "transient"}:
+                    self._sleep(1.0 if error.code == 429 else 0.25)
+                    continue
+                raise last_error from error
+            except (urllib.error.URLError, TimeoutError, socket.timeout) as error:
+                last_error = XhsRestError(
+                    f"TikHub REST transient failure: {error}",
+                    category="transient",
+                    retry_count=attempt,
+                )
+                if attempt == 0:
+                    self._sleep(0.25)
+                    continue
+                raise last_error from error
+            except json.JSONDecodeError as error:
+                raise XhsRestError(
+                    "TikHub REST returned invalid JSON",
+                    category="provider_error",
+                    retry_count=attempt,
+                ) from error
+        raise last_error or XhsRestError("TikHub REST unavailable", category="transient")
