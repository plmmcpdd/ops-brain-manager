@@ -0,0 +1,226 @@
+import importlib.machinery
+import importlib.util
+import io
+import json
+import runpy
+import sys
+import urllib.error
+from pathlib import Path
+
+import pytest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+LIB = ROOT / "tikhub" / "lib"
+BIN = ROOT / "tikhub" / "bin" / "tikhub"
+sys.path.insert(0, str(LIB))
+
+
+def load_rest():
+    path = LIB / "xhs_rest_client.py"
+    spec = importlib.util.spec_from_file_location("xhs_rest_under_test", path)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def load_cli():
+    loader = importlib.machinery.SourceFileLoader("tikhub_cli_under_test", str(BIN))
+    spec = importlib.util.spec_from_loader(loader.name, loader)
+    module = importlib.util.module_from_spec(spec)
+    loader.exec_module(module)
+    return module
+
+
+class FakeResponse:
+    def __init__(self, payload, status=200):
+        self.status = status
+        self.body = json.dumps(payload, ensure_ascii=False).encode()
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_args):
+        return False
+
+    def read(self):
+        return self.body
+
+
+EXPECTED_ACTIONS = {
+    "search_notes", "search_users", "get_user_posted_notes",
+    "get_image_note_detail", "get_video_note_detail", "get_note_comments",
+    "get_note_sub_comments", "get_user_info",
+}
+
+
+def test_action_schema_matches_verified_app_v2_contract():
+    module = load_rest()
+    assert set(module.ACTION_SCHEMAS) == EXPECTED_ACTIONS
+    search = module.ACTION_SCHEMAS["search_notes"]
+    assert search["required"] == {"keyword"}
+    assert search["integer"] == {"page", "ai_mode"}
+    assert search["defaults"] == {
+        "page": 1,
+        "sort_type": "general",
+        "note_type": "不限",
+        "time_filter": "不限",
+        "search_id": "",
+        "search_session_id": "",
+        "source": "explore_feed",
+        "ai_mode": 0,
+    }
+
+
+def test_search_normalization_preserves_items_metadata_and_provider_ids():
+    module = load_rest()
+    payload = {
+        "code": 200,
+        "request_id": "req-1",
+        "message": "ok",
+        "data": {"data": {
+            "items": [{"id": "note-1", "xsec_token": "follow-up-token"}],
+            "search_id": "search-1",
+            "search_session_id": "session-1",
+            "has_more": True,
+        }},
+    }
+    result = module.normalize_response("search_notes", payload, 200)
+    assert result["transport"] == "rest"
+    assert result["items"] == [{"id": "note-1", "xsec_token": "follow-up-token"}]
+    assert result["pagination"] == {
+        "search_id": "search-1", "search_session_id": "session-1", "has_more": True,
+    }
+    assert result["provider"]["request_id"] == "req-1"
+
+
+def test_parameter_validation_coerces_verified_integer_fields_and_rejects_unknown():
+    module = load_rest()
+    params = module.validate_arguments("search_notes", {"keyword": "移民", "page": "2", "ai_mode": "0"})
+    assert params["page"] == 2
+    assert params["ai_mode"] == 0
+    with pytest.raises(module.XhsRestError, match="unsupported parameter"):
+        module.validate_arguments("search_notes", {"keyword": "移民", "web_v3_cursor": "x"})
+
+
+def test_401_is_credential_problem_without_retry():
+    module = load_rest()
+    calls = []
+
+    def fail(request, timeout):
+        calls.append(request.full_url)
+        raise urllib.error.HTTPError(request.full_url, 401, "unauthorized", {}, io.BytesIO(b"{}"))
+
+    client = module.XhsRestClient(api_key="test", urlopen=fail, sleep=lambda _: None)
+    with pytest.raises(module.XhsRestError) as caught:
+        client.call("search_notes", {"keyword": "移民"})
+    assert caught.value.category == "credential_problem"
+    assert len(calls) == 1
+
+
+def test_429_backs_off_once_and_does_not_change_request():
+    module = load_rest()
+    calls, sleeps = [], []
+
+    def open_request(request, timeout):
+        calls.append(request.full_url)
+        if len(calls) == 1:
+            raise urllib.error.HTTPError(request.full_url, 429, "limited", {}, io.BytesIO(b"{}"))
+        return FakeResponse({"code": 200, "data": {"data": {"items": []}}})
+
+    client = module.XhsRestClient(api_key="test", urlopen=open_request, sleep=sleeps.append)
+    result = client.call("search_notes", {"keyword": "移民"})
+    assert result["items"] == []
+    assert calls[0] == calls[1]
+    assert sleeps == [1.0]
+
+
+def test_4xx_request_error_is_not_retried():
+    module = load_rest()
+    calls = []
+
+    def fail(request, timeout):
+        calls.append(request.full_url)
+        raise urllib.error.HTTPError(request.full_url, 422, "schema", {}, io.BytesIO(b"{}"))
+
+    client = module.XhsRestClient(api_key="test", urlopen=fail, sleep=lambda _: None)
+    with pytest.raises(module.XhsRestError) as caught:
+        client.call("search_notes", {"keyword": "移民"})
+    assert caught.value.category == "request_error"
+    assert len(calls) == 1
+
+
+def test_5xx_retries_once_then_marks_rest_unavailable():
+    module = load_rest()
+    calls, sleeps = [], []
+
+    def fail(request, timeout):
+        calls.append(request.full_url)
+        raise urllib.error.HTTPError(request.full_url, 503, "down", {}, io.BytesIO(b"{}"))
+
+    client = module.XhsRestClient(api_key="test", urlopen=fail, sleep=sleeps.append)
+    with pytest.raises(module.XhsRestError) as caught:
+        client.call("search_notes", {"keyword": "移民"})
+    assert caught.value.payload() == {
+        "error": "TikHub REST HTTP 503",
+        "layer": "TikHub",
+        "platform": "xiaohongshu",
+        "transport": "rest",
+        "status": "unavailable",
+        "category": "transient",
+        "http_status": 503,
+        "retry_count": 1,
+    }
+    assert len(calls) == 2
+    assert sleeps == [0.25]
+
+
+def test_successful_http_with_provider_error_is_not_faked_as_success():
+    module = load_rest()
+    client = module.XhsRestClient(
+        api_key="test",
+        urlopen=lambda request, timeout: FakeResponse({"code": 5001, "message": "provider failed"}),
+        sleep=lambda _: None,
+    )
+    with pytest.raises(module.XhsRestError) as caught:
+        client.call("search_notes", {"keyword": "移民"})
+    assert caught.value.category == "provider_error"
+
+
+def test_xhs_catalog_exposes_only_implemented_app_v2_actions():
+    cli = load_cli()
+    names = {tool["name"] for tool in cli._load_cached_tools("xiaohongshu")}
+    assert names == {f"xiaohongshu_app_v2_{action}" for action in EXPECTED_ACTIONS}
+    assert not any("web_v2" in name or "web_v3" in name for name in names)
+    assert not any(name.startswith("xiaohongshu_app_") and "app_v2" not in name for name in names)
+
+
+def test_agent_instructions_and_dispatch_do_not_recommend_obsolete_xhs_routes():
+    checked = [
+        ROOT / "SKILL.md",
+        ROOT / "references" / "diagnostic-mode.md",
+        ROOT / "references" / "platforms" / "xiaohongshu.md",
+        ROOT / "scripts" / "dispatch_account.py",
+    ]
+    obsolete_commands = (
+        "xiaohongshu_app_get_",
+        "xiaohongshu_app_search_",
+        "xiaohongshu_web_search_",
+        "xiaohongshu_web_v2_",
+        "xiaohongshu_web_v3_",
+    )
+    for path in checked:
+        text = path.read_text(encoding="utf-8")
+        assert not any(command in text for command in obsolete_commands), path
+    skill = checked[0].read_text(encoding="utf-8")
+    assert "Direct App V2 REST" in skill
+    assert "secondary evidence" in skill
+
+
+def test_xhs_dispatch_uses_only_stable_rest_adapter_commands():
+    namespace = runpy.run_path(str(ROOT / "scripts" / "dispatch_account.py"))
+    rule = next(rule for rule in namespace["PLATFORM_RULES"] if rule["platform"] == "xiaohongshu")
+    assert set(rule["tools"].values()) == {
+        f"tikhub xiaohongshu {action}" for action in EXPECTED_ACTIONS
+    }
