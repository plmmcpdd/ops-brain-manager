+
+ROOT = Path(__file__).resolve().parents[1]
+CONTRACT_PATH = ROOT / "references" / "find-budget-contract.json"
+SKILL_PATH = ROOT / "SKILL.md"
+
+
+def load_contract():
+    return json.loads(CONTRACT_PATH.read_text(encoding="utf-8"))
+
+
+def candidate_find(result_batches, requested, *, with_intent=False):
+    contract = load_contract()["stages"]["CANDIDATE_FIND"]
+    candidates = []
+    seen = set()
+    search_calls = 0
+    for batch in result_batches[: contract["budgets"]["search_notes"]]:
+        search_calls += 1
+        for item in batch:
+            note_id = item.get("note_id")
+            if note_id and note_id not in seen and item.get("relevant", True):
+                seen.add(note_id)
+                candidates.append(item)
+        if len(candidates) >= requested:
+            break
+    final = candidates[:requested]
+    return {
+        "search_notes": search_calls,
+        "search_users": 0,
+        "get_user_info": 0,
+        "detail": 0,
+        "comments": [item["note_id"] for item in final] if with_intent else [],
+        "visual": 0,
+        "candidates": final,
+        "insufficient": len(final) < requested,
+        "stopped": True,
+    }
+
+
+def items(count, start=0):
+    return [{"note_id": f"note-{index}", "relevant": True} for index in range(start, start + count)]
+
+
+def test_case_a_first_search_has_twenty_return_five_and_stop():
+    result = candidate_find([items(20)], 5)
+    assert result == {
+        "search_notes": 1,
+        "search_users": 0,
+        "get_user_info": 0,
+        "detail": 0,
+        "comments": [],
+        "visual": 0,
+        "candidates": items(5),
+        "insufficient": False,
+        "stopped": True,
+    }
+
+
+def test_case_b_three_then_supplementary_never_exceeds_two_searches():
+    result = candidate_find([items(3), items(4, start=3), items(20, start=7)], 5)
+    assert result["search_notes"] == 2
+    assert len(result["candidates"]) == 5
+    assert result["insufficient"] is False
+    assert result["stopped"] is True
+
+
+def test_case_c_two_searches_return_four_and_mark_insufficient():
+    result = candidate_find([items(2), items(2, start=2), items(20, start=4)], 5)
+    assert result["search_notes"] == 2
+    assert len(result["candidates"]) == 4
+    assert result["insufficient"] is True
+    assert result["stopped"] is True
+
+
+def test_case_d_intent_comments_only_target_final_candidates():
+    result = candidate_find([items(20)], 5, with_intent=True)
+    assert result["search_notes"] == 1
+    assert result["comments"] == [f"note-{index}" for index in range(5)]
+    assert result["detail"] == 0
+    assert result["visual"] == 0
+
+
+def test_case_e_enrichment_is_selected_items_only_without_new_search():
+    stage = load_contract()["stages"]["ENRICH_CRACK"]
+    candidate_ids = [f"note-{index}" for index in range(1, 6)]
+    selected = [candidate_ids[index - 1] for index in (2, 4)]
+    assert selected == ["note-2", "note-4"]
+    assert stage["requires_explicit_owner_selection"] is True
+    assert stage["scope"] == "selected_items_only"
+    assert stage["rerun_candidate_search"] is False
+
+
+def test_contract_budget_and_production_instructions_are_explicit():
+    contract = load_contract()["stages"]["CANDIDATE_FIND"]
+    assert contract["normal_target_rest_calls"] == 1
+    assert contract["budgets"] == {"search_notes": 2, "other_rest": 0, "visual": 0}
+    assert contract["allowed_actions"] == ["search_notes"]
+    assert contract["stop_when_candidate_count_reaches_requested"] is True
+
+    skill = SKILL_PATH.read_text(encoding="utf-8")
+    assert "references/find-budget-contract.json" in skill
+    assert "STOP SEARCHING" in skill
+    assert "CANDIDATE_FIND_WITH_INTENT" in skill
+    assert "ENRICH / CRACK" in skill
+    assert "矩阵词并行搜索" not in skill
+    assert "候选池每条抽首图" not in skill
