+{
+  "version": 1,
+  "platform": "xiaohongshu",
+  "stages": {
+    "CANDIDATE_FIND": {
+      "default_requested_candidates": 5,
+      "maximum_initial_response_candidates": 10,
+      "normal_target_rest_calls": 1,
+      "budgets": {
+        "search_notes": 2,
+        "other_rest": 0,
+        "visual": 0
+      },
+      "allowed_actions": ["search_notes"],
+      "forbidden_actions": [
+        "search_users",
+        "get_user_info",
+        "get_user_posted_notes",
+        "get_image_note_detail",
+        "get_video_note_detail",
+        "get_note_comments",
+        "get_note_sub_comments",
+        "analyze_image",
+        "analyze_video"
+      ],
+      "stop_when_candidate_count_reaches_requested": true,
+      "return_partial_after_budget_exhaustion": true,
+      "deduplicate_by": "note_id"
+    },
+    "CANDIDATE_FIND_WITH_INTENT": {
+      "inherits": "CANDIDATE_FIND",
+      "comments_per_final_candidate": 1,
+      "comments_scope": "final_candidates_only",
+      "other_enrichment": 0,
+      "visual": 0
+    },
+    "ENRICH_CRACK": {
+      "requires_explicit_owner_selection": true,
+      "scope": "selected_items_only",
+      "rerun_candidate_search": false
+    }
+  }
+}
