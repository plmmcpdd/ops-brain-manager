{
  "version": 1,
  "capabilities": [
    {
      "id": "social-account-doctor",
      "display_name": "social-account-doctor",
      "runtime": "claude",
      "install_location": "~/.claude/skills/social-account-doctor",
      "configuration_file": ".env",
      "source": "https://github.com/JuneYaooo/social-account-doctor.git",
      "pinned_commit": "88bb251248ca05d7e17c5eed6a7d3885d938180e",
      "expected_installed_content_sha256": "c0abd88f0c1e60c09bd57fae6a8babd969e6d145e5364b393612db3c9813709c",
      "expected_hashed_file_count": 52,
      "license": "MIT",
      "local_patches": [
        {
          "id": "doubao-ark-chat-url",
          "path": "shared-capabilities/patches/social-account-doctor/0001-doubao-ark-chat-url.patch",
          "applies_to_commit": "88bb251248ca05d7e17c5eed6a7d3885d938180e",
          "description": "Add /api/v3 OpenAI-compatible chat endpoint support for Doubao Ark"
        },
        {
          "id": "visual-batch-performance",
          "path": "shared-capabilities/patches/social-account-doctor/0002-visual-batch-performance.patch",
          "applies_to_commit": "88bb251248ca05d7e17c5eed6a7d3885d938180e",
          "description": "Batch covers at configurable concurrency, disable optional thinking, and add safe timing metrics"
        },
        {
          "id": "tikhub-failure-policy",
          "path": "shared-capabilities/patches/social-account-doctor/0003-tikhub-failure-policy.patch",
          "applies_to_commit": "88bb251248ca05d7e17c5eed6a7d3885d938180e",
          "description": "Bound TikHub retries, refresh only session failures, and preserve evidence provenance"
        },
        {
          "id": "xhs-app-v2-rest-primary",
          "path": "shared-capabilities/patches/social-account-doctor/0004-xhs-app-v2-rest-primary.patch",
          "applies_to_commit": "88bb251248ca05d7e17c5eed6a7d3885d938180e",
          "description": "Route Xiaohongshu production actions through normalized Direct App V2 REST"
        },
        {
          "id": "find-budget-stop-condition",
          "path": "shared-capabilities/patches/social-account-doctor/0005-find-budget-stop-condition.patch",
          "applies_to_commit": "88bb251248ca05d7e17c5eed6a7d3885d938180e",
          "description": "Bound candidate find to two searches, stop at the requested count, and defer enrichment until owner selection"
        }
      ],
      "executables": [
        {"id": "python3", "command": "python3", "required": true},
        {"id": "tikhub", "path": "~/.local/bin/tikhub", "required": true},
        {"id": "ffmpeg", "path": "~/.local/bin/ffmpeg", "required": false},
        {"id": "ffprobe", "path": "~/.local/bin/ffprobe", "required": false}
      ],
      "components": [
        {"id": "XHS App V2 REST", "required": true, "config_keys": ["TIKHUB_API_KEY", "TIKHUB_XHS_TRANSPORT", "TIKHUB_REST_BASE_URL"], "executables": ["tikhub"]},
        {"id": "TikHub MCP", "required": false, "config_keys": ["TIKHUB_API_KEY"], "executables": ["tikhub"], "status_override": "DEGRADED"},
        {"id": "Visual Analysis", "required": false, "config_keys": ["VIDEO_ANALYSIS_API_KEY", "VIDEO_ANALYSIS_BASE_URL", "VIDEO_ANALYSIS_MODEL_NAME"], "executables": []},
        {"id": "Audio Transcription", "required": false, "config_keys": ["AUDIO_TRANSCRIPTION_API_KEY"], "executables": []},
        {"id": "Video Processing", "required": false, "config_keys": [], "executables": ["ffmpeg", "ffprobe"]}
      ]
    }
  ]
}
